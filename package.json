{
  "name": "desktop-pet-tool",
  "version": "1.0.3",
  "description": "桌面悬浮宠物工具 - 集计时、键盘统计、趣味语录和应急防查岗功能于一体",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac",
    "build:release": "electron-builder --win --publish always",
    "rebuild": "electron-rebuild"
  },
  "author": "Desktop Pet Tool",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.6.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.4"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "uiohook-napi": "^1.5.1"
  },
  "build": {
    "appId": "com.desktoppet.tool",
    "productName": "桌面宠物工具",
    "directories": {
      "output": "build"
    },
    "artifactName": "desktop-pet-tool-setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "mbc27",
      "repo": "desktop-pet-tool",
      "private": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/electron-store/**",
      "node_modules/conf/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
